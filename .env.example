# Copy to .env on the server and fill in. Never commit .env.
# Generate secrets with:  openssl rand -hex 32

APP_PORT=8005
FRONTEND_URL=https://taskflow.maslecodes.fun

# --- DATABASE ---
POSTGRES_USER=taskflow_user
POSTGRES_PASSWORD=
POSTGRES_DB=taskflow

# --- BACKEND ---
JWT_SECRET=

# --- FRONTEND ---
# /api = same domain; the frontend container forwards it to the backend
VITE_API_URL=/api
